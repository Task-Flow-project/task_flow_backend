{
	"info": {
		"name": "TaskFlow Auth API",
		"description": "Auth endpoints: Register via OTP, Login, Google OAuth, Logout, Me",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost"
		},
		{
			"key": "email",
			"value": "test@taskflow.com"
		},
		{
			"key": "password",
			"value": "password123"
		},
		{
			"key": "otp_code",
			"value": ""
		},
		{
			"key": "token",
			"value": ""
		}
	],
	"item": [
		{
			"name": "1. Register",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (pm.response.code === 201) {",
							"    pm.collectionVariables.set('email', jsonData.user.email);",
							"    console.log('User registered:', jsonData.user.email);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\",\n    \"password_confirmation\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/register",
					"host": ["{{base_url}}"],
					"path": ["api", "register"]
				}
			}
		},
		{
			"name": "2. Resend OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/resend-otp",
					"host": ["{{base_url}}"],
					"path": ["api", "resend-otp"]
				}
			}
		},
		{
			"name": "3. Verify OTP",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (pm.response.code === 200 && jsonData.token) {",
							"    pm.collectionVariables.set('token', jsonData.token);",
							"    console.log('Token saved:', jsonData.token);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"otp_code\": \"{{otp_code}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/verify-otp",
					"host": ["{{base_url}}"],
					"path": ["api", "verify-otp"]
				}
			}
		},
		{
			"name": "4. Login",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var jsonData = pm.response.json();",
							"if (pm.response.code === 200 && jsonData.token) {",
							"    pm.collectionVariables.set('token', jsonData.token);",
							"    console.log('Token saved:', jsonData.token);",
							"}"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"{{email}}\",\n    \"password\": \"{{password}}\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/login",
					"host": ["{{base_url}}"],
					"path": ["api", "login"]
				}
			}
		},
		{
			"name": "5. Me (Get Current User)",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/me",
					"host": ["{{base_url}}"],
					"path": ["api", "me"]
				}
			}
		},
		{
			"name": "6. Google Redirect URL",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auth/google/redirect",
					"host": ["{{base_url}}"],
					"path": ["api", "auth", "google", "redirect"]
				}
			}
		},
		{
			"name": "7. Google Callback",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/auth/google/callback?code=CODE_FROM_GOOGLE",
					"host": ["{{base_url}}"],
					"path": ["api", "auth", "google", "callback"],
					"query": [
						{
							"key": "code",
							"value": "CODE_FROM_GOOGLE"
						}
					]
				}
			}
		},
		{
			"name": "8. Logout",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Accept",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"url": {
					"raw": "{{base_url}}/api/logout",
					"host": ["{{base_url}}"],
					"path": ["api", "logout"]
				}
			}
		}
	]
}
